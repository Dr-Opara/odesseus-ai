{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/job-discovery",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/refresh-job-feed",
      "schedule": "30 */6 * * *"
    },
    {
      "path": "/api/cron/process-retry-jobs",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/process-notification-emails",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/process-interview-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/expire-featured-listings",
      "schedule": "17 */6 * * *"
    }
  ]
}
