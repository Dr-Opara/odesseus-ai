# `npm run dev` refuses to start without both Supabase vars below — it will
# NOT silently fall back to the production project (see next.config.ts and
# src/lib/supabase/public-config.ts). Local development should target the
# LOCAL Supabase stack started with `supabase start` (kong on
# http://127.0.0.1:54321). Copy this file to `.env.local` and set:
#
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key from `supabase status`>
#   SUPABASE_SERVICE_ROLE_KEY=<service-role key from `supabase status`>
#   NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
#
# The values in this file are placeholders for the DEPLOYED app (Vercel
# Preview/Production configure real per-environment credentials in the Vercel
# dashboard). Never commit real credentials here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

OPENAI_API_KEY=your_server_side_openai_key
ODESSEUS_MATCH_MODEL=gpt-5.6-luna

STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
SUPABASE_SERVICE_ROLE_KEY=your_server_side_service_role_key

BROWSERBASE_API_KEY=your_browserbase_api_key
BROWSERBASE_PROJECT_ID=your_browserbase_project_id

ODESSEUS_CONNECT_GOOGLE_CONNECTOR=your_google_connector_id
CRON_SECRET=your_random_cron_secret

ODESSEUS_CONNECT_YAHOO_CONNECTOR=your_yahoo_connector_id
ODESSEUS_CONNECT_INDEED_CONNECTOR=your_indeed_connector_id

ODESSEUS_LIVE_GUIDANCE_MODEL=gpt-5.6-luna

ODESSEUS_POST_INTERVIEW_MODEL=gpt-5.6-luna
ODESSEUS_CONNECT_GOOGLE_SEND_CONNECTOR=optional_google_send_connector


# Automatic Job Discovery
# JSON array of public ATS job-board sources.
# Example:
# [{"provider":"greenhouse","companyName":"Example Co","slug":"example"},
#  {"provider":"lever","companyName":"Example Labs","slug":"examplelabs"},
#  {"provider":"ashby","companyName":"Example AI","slug":"ExampleAI"}]
ODESSEUS_JOB_SOURCES_JSON=[]
ODESSEUS_JOB_DISCOVERY_MAX_MATCHES_PER_USER=12