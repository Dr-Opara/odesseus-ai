# Automatic Job Discovery
# JSON array of public ATS job-board sources.
# Example:
# [{"provider":"greenhouse","companyName":"Example Co","slug":"example"},
#  {"provider":"lever","companyName":"Example Labs","slug":"examplelabs"},
#  {"provider":"ashby","companyName":"Example AI","slug":"ExampleAI"}]
